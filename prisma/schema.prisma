// Configuración de base de datos
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---

enum Role {
  COMUNERO
  EMPRESA
  ADMIN
  AUDITOR
  DIRECTIVA
}

enum ExperienciaCategoria {
  MINERIA
  GENERAL
}

enum TrustLevel {
  VERDE
  AMARILLO
  ROJO
}

enum ApplicationStatus {
  PRESENTACION_CV
  SEGURIDAD
  EVALUACION
  ENTREVISTA
  MEDICO
  INDUCCION
  CONTRATADO
  RECHAZADO
}

enum ContractStatus {
  ACTIVO
  VENCIDO
  TERMINADO_PREMATURO
  RENOVADO
}

enum Gender {
  MASCULINO
  FEMENINO
  OTRO
}

enum TipoManoObra {
  NO_CALIFICADA
  SEMI_CALIFICADA
  CALIFICADA
  PROFESIONAL
  TECNICO
  PRACTICAS
}

enum OfertaStatus {
  VIGENTE
  CULMINADO
}

enum ComunicacionEstado {
  PENDIENTE
  LEIDO
  RESPONDIDO
}

/// Diferencia capacitaciones del CV vs programa de entrenamiento laboral (Antamina/socio)
enum TipoCapacitacion {
  CV_HISTORIAL
  PROGRAMA_ENTRENAMIENTO
}

// --- MODELOS CORE ---

model Tenant {
  id        String    @id @default(uuid())
  name      String    // Nombre de la Comunidad o Empresa Minera
  type      String    // 'MINERA' | 'COMUNIDAD'
  trustLevel TrustLevel @default(VERDE) // Semáforo de Confianza
  users     User[]
  reclamos  Reclamo[] @relation("TenantReclamos")
  semaforoHistory SemaforoHistory[]
  ofertas   Oferta[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model SemaforoHistory {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  nivelAnterior TrustLevel
  nivelNuevo    TrustLevel
  justificacion String     @db.Text
  userId        String?
  createdAt     DateTime   @default(now())
}

model Reclamo {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tenantId    String
  tenant      Tenant   @relation("TenantReclamos", fields: [tenantId], references: [id])
  motivo      String   @db.Text
  estado      String   @default("PENDIENTE") // PENDIENTE, EN_REVISION, RESUELTO
  respuestaOficial String? @db.Text // Respuesta personalizada o medidas tomadas
  blockchainHash String? // Para inmutabilidad
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id              String      @id @default(uuid())
  dni             String      @unique
  email           String?     @unique
  password        String      // Para autenticación
  phone           String?
  fullName        String
  role            Role        @default(COMUNERO)
  gender          Gender?     // Para analítica de participación
  biometricHash   String?     // Hash de biometría facial para auth segura
  trustLevel      TrustLevel  @default(VERDE)
  points          Int         @default(0) // Sistema de Gamificación
  sector          String?     // Para censo por sector (Agrario, Minero, etc.)
  
  // Relaciones
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  cv              CV?
  postulaciones   Postulacion[] @relation("PostulacionCandidato")
  postulacionesEnviadas Postulacion[] @relation("PostulacionSubmittedBy")
  comunicacionesEnviadas ComunicacionPostulacion[] @relation("ComunicacionRemitente")
  comunicacionesRecibidas ComunicacionPostulacion[] @relation("ComunicacionDestinatario")
  contratos       Contrato[]
  capacitaciones  CapacitacionUsuario[]
  encuestaEntrenamiento EncuestaEntrenamientoLaboral?
  evaluaciones    Evaluacion[] @relation("Evaluado")
  reclamos        Reclamo[]
  notificaciones  Notificacion[]
  
  // Auditoría
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
}

model CV {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  
  aiSummary         String?   @db.Text // Perfil profesional generado por IA
  specialty         String?   // Especialidad u oficio principal (Ej: Electricista)
  yearsExperience   Decimal   @default(0) @db.Decimal(5, 2)
  yearsExperienceMining Decimal @default(0) @db.Decimal(5, 2)
  yearsExperienceGeneral Decimal @default(0) @db.Decimal(5, 2)
  multimedia        Json?     // { "videos": [...], "photos": [...] }
  blockchainHash    String?   // Certificación de veracidad del CV
  
  experiencias      ExperienciaLaboral[]
  educaciones       Educacion[]
  habilidades       Habilidad[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

model ExperienciaLaboral {
  id              String    @id @default(uuid())
  cvId            String
  cv              CV        @relation(fields: [cvId], references: [id])
  company         String
  position        String
  /// Área / unidad (ej. Mantenimiento, Operaciones)
  area            String?
  /// Logros / responsabilidades destacadas
  logros          String?   @db.Text
  categoria       ExperienciaCategoria @default(GENERAL)
  startDate       DateTime
  endDate         DateTime?
  isVerified      Boolean   @default(false)
  verificationHash String?  // Hash blockchain de la constancia
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model Educacion {
  id              String    @id @default(uuid())
  cvId            String
  cv              CV        @relation(fields: [cvId], references: [id])
  institucion     String
  titulo          String
  tipoEstudio     String    // Ej: Primaria, Secundaria, Técnico, Universitario
  startDate       DateTime
  endDate         DateTime?
  isVerified      Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model Oferta {
  id                    String         @id @default(uuid())
  title                 String         // Nombre del puesto
  description           String         @db.Text // Funciones / detalle
  perfilRequisitos      String?        @db.Text
  requirements          Json?          // Skills estructurados / legacy
  salary                Decimal        @db.Decimal(12, 2)
  sector                String         // Ubicación / sector geográfico
  vacancies             Int            @default(1)
  status                OfertaStatus   @default(VIGENTE)

  // Matriz Ciro — oportunidad laboral
  tenantId              String?        // Convocante / empresa
  tenant                Tenant?        @relation(fields: [tenantId], references: [id])
  companyName           String?        // Denormalizado para listados rápidos
  tipoManoObra          TipoManoObra   @default(NO_CALIFICADA)
  fechaInicioProyectada DateTime?
  fechaCierre           DateTime?      // Para "falta X días" / vigencia
  regimenLaboral        String?
  tiempoContratoMeses   Int?
  horarioTrabajo        String?
  sistemaTrabajo        String?
  notaAviso             String?        @db.Text

  postulaciones         Postulacion[]

  createdAt             DateTime       @default(now()) // Fecha de registro
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?
}

model Postulacion {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation("PostulacionCandidato", fields: [userId], references: [id])
  ofertaId        String
  oferta          Oferta            @relation(fields: [ofertaId], references: [id])

  /// Quien registro la postulacion (comunero, directiva o empresa)
  submittedById   String?
  submittedBy     User?             @relation("PostulacionSubmittedBy", fields: [submittedById], references: [id])
  
  status          ApplicationStatus @default(PRESENTACION_CV)
  /// TimelineEvent[] tipado (timeline.constants.ts)
  timeline        Json
  aiMatchingScore Decimal?          @db.Decimal(5, 2)
  
  contrato        Contrato?
  comunicaciones  ComunicacionPostulacion[]
  alertasDeadline AlertaDeadline[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
}

model Contrato {
  id                String         @id @default(uuid())
  postulacionId     String         @unique
  postulacion       Postulacion    @relation(fields: [postulacionId], references: [id])
  userId            String
  user              User           @relation(fields: [userId], references: [id])

  /// Matriz de contrato (alineada a oferta + datos del comunero)
  numeroContrato    String?
  companyName       String?        // Empresa contratante
  puesto            String?        // Nombre del puesto
  cargo             String?        // Cargo específico
  area              String?
  sector            String?        // Ubicación / sector geográfico
  tipoManoObra      TipoManoObra?
  startDate         DateTime
  endDate           DateTime
  salary            Decimal        @db.Decimal(12, 2)
  regimenLaboral    String?        // Régimen laboral (ej: 728, 1057, etc.)
  tiempoContratoMeses Int?
  horarioTrabajo    String?
  sistemaTrabajo    String?
  observaciones     String?        @db.Text
  status            ContractStatus @default(ACTIVO)
  stabilityIndex    Decimal        @db.Decimal(5, 2) // Cálculo de estabilidad laboral

  blockchainProof   String?        // Hash del contrato legal firmado
  evaluaciones      Evaluacion[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  @@index([companyName])
  @@index([puesto])
}

model Capacitacion {
  id              String    @id @default(uuid())
  title           String
  description     String
  learningPath    Json      // Ruta sugerida de aprendizaje
  sector          String
  futureDemand    Boolean   @default(false) // Si es una habilidad demandada a futuro
  /// CV_HISTORIAL = historial del comunero en el CV
  /// PROGRAMA_ENTRENAMIENTO = cursos del programa Antamina / socio
  tipo            TipoCapacitacion @default(CV_HISTORIAL)
  /// Socio/empresa organizadora (relevante para programa de entrenamiento)
  socioOrganizador String?
  
  usuarios        CapacitacionUsuario[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model CapacitacionUsuario {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  capacitacionId  String
  capacitacion    Capacitacion @relation(fields: [capacitacionId], references: [id])
  
  progress        Int       @default(0)
  isCertified     Boolean   @default(false)
  certificateHash String?   // Certificación dual blockchain
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, capacitacionId])
}

/// Encuesta / ficha del Programa de Entrenamiento Laboral (Antamina u otro socio)
model EncuestaEntrenamientoLaboral {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id])

  /// ¿Has sido capacitado por Antamina / programa de entrenamiento?
  capacitadoPorAntamina  Boolean  @default(false)
  anioParticipacion       Int?
  socioOrganizador        String?  // Ej. Antamina, Ferreyros
  nombrePrograma          String?
  horas                   Int?
  temas                   String?  @db.Text
  obtuvoCertificado       Boolean  @default(false)
  observaciones           String?  @db.Text
  /// Respuestas adicionales de la encuesta
  respuestas              Json?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Evaluacion {
  id                String    @id @default(uuid())
  contractId        String
  contract          Contrato  @relation(fields: [contractId], references: [id])
  evaluatorId       String
  evaluadoId        String
  evaluado          User      @relation("Evaluado", fields: [evaluadoId], references: [id])
  
  satisfaccion      Int       @default(5) // Escala 1-5 (satisfacción general)
  discriminacion    Boolean   @default(false)
  /// Respuestas completas del cuestionario 360° de satisfacción del trabajador
  cuestionario      Json?
  feedbackTexto     String?   @db.Text
  grabacionUrl      String?   // Para video/audio
  sentimientoIA     Json?     // Resultado de análisis (score, emociones, etc.)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

model Habilidad {
  id              String    @id @default(uuid())
  cvId            String
  cv              CV        @relation(fields: [cvId], references: [id])
  name            String
  isVerified      Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id              String    @id @default(uuid())
  entityName      String    // Ej: 'Contrato'
  entityId        String
  action          String    // 'CREATE', 'UPDATE', 'DELETE'
  oldData         Json?
  newData         Json?
  userId          String    // Quién realizó el cambio
  immutableHash   String    // Hash para garantizar integridad del log
  
  createdAt       DateTime  @default(now())
}

model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String
  user      User     @relation(fields: [usuarioId], references: [id])
  mensaje   String
  tipo      String   // 'OFERTA', 'VENCIMIENTO', 'PROCESO', 'GENERAL'
  estado    String   @default("PENDIENTE") // PENDIENTE, ENVIADO, ERROR
  leido     Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Evidencia de comunicación en el proceso de convocatoria (chat por postulación)
model ComunicacionPostulacion {
  id             String             @id @default(uuid())
  postulacionId  String
  postulacion    Postulacion        @relation(fields: [postulacionId], references: [id])
  remitenteId    String
  remitente      User               @relation("ComunicacionRemitente", fields: [remitenteId], references: [id])
  destinatarioId String
  destinatario   User               @relation("ComunicacionDestinatario", fields: [destinatarioId], references: [id])
  mensaje        String             @db.Text
  estado         ComunicacionEstado @default(PENDIENTE)

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

/// Evita duplicar alertas de deadline (5 días antes)
model AlertaDeadline {
  id            String      @id @default(uuid())
  postulacionId String
  postulacion   Postulacion @relation(fields: [postulacionId], references: [id])
  eventId       String
  deadlineDate  DateTime
  mensaje       String
  sentAt        DateTime    @default(now())

  @@unique([postulacionId, eventId])
}

model Acuerdo {
  id                String   @id @default(uuid())
  titulo            String
  descripcion       String   @db.Text
  fechaFirma        DateTime
  fechaCumplimiento DateTime?
  estado            String   @default("PENDIENTE") // PENDIENTE, CUMPLIDO
  documentoUrl      String?
  partesInvolucradas Json     // ["Comunidad X", "Empresa Y"]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Centro poblado / sector georreferenciado (Área de influencia Antamina / Ancash)
model SectorGeografico {
  id            String   @id @default(uuid())
  codigo        String   @unique
  nombre        String
  /// Alias para emparejar textos libres de User.sector / Oferta.sector
  aliases       String[] @default([])
  latitud       Float
  longitud      Float
  departamento  String   @default("Ancash")
  provincia     String?
  distrito      String?
  activo        Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}
